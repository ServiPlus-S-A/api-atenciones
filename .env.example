# =============================================================================
# ServiPlus Atenciones — Variables de entorno (copiar a .env)
# =============================================================================

# Django
DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — pooler Supabase (puerto 6543) para tráfico de aplicación
# CONN_MAX_AGE=0: conexiones no persistentes; obligatorio con PgBouncer en modo transaction
DATABASE_URL=postgresql://user:password@host:6543/atenciones_db?sslmode=require
CONN_MAX_AGE=0

# PostgreSQL — conexión directa (puerto 5432) SOLO para migraciones y management commands
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/atenciones_db?sslmode=require

# Redis dual: caché de aplicación vs broker Celery
REDIS_CACHE_URL=redis://redis-local:6379/0
CELERY_BROKER_URL=redis://redis-local:6379/1
CELERY_RESULT_BACKEND=redis://redis-local:6379/2

# JWT
SIMPLE_JWT_SIGNING_KEY=change-me-jwt-signing

# Servicios externos
SOLICITUDES_URL=http://solicitudes:8001/api
PARAMETRIZACION_URL=http://parametrizacion:8002/api
SOLICITUDES_HEALTH_URL=http://solicitudes:8001/health/

# Supabase Storage (archival audit_log — CONCERN-03)
SUPABASE_STORAGE_BUCKET=audit-archives
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Email (producción)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
